{
  "type": "module",
  "scripts": {
    "build:release": "anchor build -- --no-default-features",
    "deploy:mainnet": "solana program deploy --with-compute-unit-price 200000  --max-sign-attempts 10000 --url https://intensive-alien-wish.solana-mainnet.quiknode.pro/77ca2cba4139e49efe0c0a891d16b2cfa31735bc/ --keypair ./wallets/deployer.json --upgrade-authority ./wallets/deployer.json --program-id ./wallets/7vLXAAhUcPE4YR5HnJtRPf9cumpYuR43fukAh9XjLUD4.json target/deploy/onlybags.so",
    "deploy:devnet": "solana program deploy --with-compute-unit-price 1000000  --max-sign-attempts 1000 --url https://api.devnet.solana.com --keypair ./wallets/deployer.json --upgrade-authority ./wallets/deployer.json --program-id ./wallets/test/onlybags_v2.json target/deploy/onlybags.so",
    "init:mainnet": "ENV=mainnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/.js",
    "init:devnet": "ENV=devnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/.js",
    "createToken:mainnet": "ENV=mainnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/createToken.js",
    "createToken:devnet": "ENV=devnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/createToken.js",
    "createTaxToken:mainnet": "ENV=mainnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/createTaxToken.js",
    "createTaxToken:devnet": "ENV=devnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/createTaxToken.js",
    "buy:mainnet": "ENV=mainnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/buy.js",
    "buy:devnet": "ENV=devnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/buy.js",
    "sell:mainnet": "ENV=mainnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/sell.js",
    "sell:devnet": "ENV=devnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/sell.js",
    "buyAndSell:mainnet": "ENV=mainnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/buyAndSell.js",
    "buyAndSell:devnet": "ENV=devnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/buyAndSell.js",
    "moveLiquidity:mainnet": "ENV=mainnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/moveLiquidity.js",
    "moveLiquidity:devnet": "ENV=devnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/moveLiquidity.js",
    "fetchData:mainnet": "ENV=mainnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/fetchData.js",
    "fetchData:devnet": "ENV=devnet ANCHOR_WALLET=./wallets/deployer.json node ./scripts/onlybags/fetchData.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.0"
  },
  "devDependencies": {
    "@apocentre/solana-web3": "Apocentre/solana-web3",
    "chai": "^4.3.4",
    "chai-as-promised": "^7.1.1",
    "mocha": "^9.0.3"
  }
}
